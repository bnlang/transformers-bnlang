{
    "name": "transformers-bnlang",
    "version": "0.4.0",
    "description": "Bnlang transformers — text-generation pipelines across four engines: onnxruntime (.onnx), onnxruntime-genai, torch (TorchScript .pt), and torch-native (.safetensors direct).",
    "license": "MIT",
    "repository": "https://github.com/bnlang/transformers-bnlang",
    "main": "lib/index.bnl",
    "dependencies": {
        "onnxruntime-bnlang": "^1.1.0",
        "onnxruntime-genai-bnlang": {
            "version": "^0.1.0",
            "platforms": ["windows-x64", "darwin-arm64", "darwin-x64"],
            "optional": true
        },
        "torch-bnlang": "^1.1.0"
    },
    "targets": {
        "darwin-arm64": "build/darwin-arm64/transformers-bnlang.dylib",
        "darwin-x64": "build/darwin-x64/transformers-bnlang.dylib",
        "linux-x64": "build/linux-x64/transformers-bnlang.so",
        "windows-x64": "build/windows-x64/transformers-bnlang.dll"
    }
}
