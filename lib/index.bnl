import "transformers-bnlang"     as native;
import "./tokenizer.bnl"         as _tok;
import "./pipeline.bnl"          as _pipe;
import "./architectures.bnl"     as _arch;
import "./streamer.bnl"          as _stream;

var version              = native.version;
var AutoTokenizer        = _tok.AutoTokenizer;
var pipeline             = _pipe.pipeline;
var register_architecture = _arch.register;
var TextStreamer         = _stream.TextStreamer;
// process.stdout.write equivalent — no newline, no buffering.
var stdout_write         = native.stdout_write;

// ---- Bangla aliases ----
var সংস্করণ              = version;                  // version
var অটো_টোকেনাইজার      = AutoTokenizer;            // AutoTokenizer
var পাইপলাইন             = pipeline;                 // pipeline
var স্থাপত্য_নিবন্ধন    = register_architecture;    // register_architecture
var টেক্সট_স্ট্রিমার    = TextStreamer;              // TextStreamer
